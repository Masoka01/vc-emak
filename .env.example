# Copy this file to .env.local, then fill in the values.
#   cp .env.example .env.local

# -- Firebase Web App config ------------------------------------------------
# From Firebase Console > Project Settings > Your Apps > (pick the `</>` web app).
# If no web app exists yet, click "Add app > Web" first.
#
# Security note: the Firebase web config is safe to expose to the browser. What
# protects the data is the Firestore rules, not this key. But NEVER put a
# service-account private key (firebase-adminsdk-*.json) in this file, because
# everything here ships to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# -- Receiver accounts ------------------------------------------------------
# Receivers self-register inside the app (email + password) and land in the
# `users` collection with `approved: false`. An admin approves them from the
# admin UI (or by setting `approved: true` on their user document); only
# approved receivers can be called — the Firestore rules enforce this.
#
# Admins are whoever has a document in the `admins` collection. That collection
# has no client-writable path, so provision it with admin credentials, e.g.:
#   firebase firestore:set --project <id> admins/<auth-uid> '{}'
# No env vars are needed for either of these; everything is Firebase Auth.
