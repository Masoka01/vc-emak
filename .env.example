# Copy this file to .env.local, then fill in the values.
#   cp .env.example .env.local

# -- Firebase Web App config ------------------------------------------------
# From Firebase Console > Project Settings > Your Apps > (pick the `</>` web app).
# If no web app exists yet, click "Add app > Web" first.
#
# Security note: the Firebase web config is safe to expose to the browser. What
# protects the data is the Firestore rules, not this key. But NEVER put a
# service-account private key (firebase-adminsdk-*.json) in this file, because
# everything here ships to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# -- Admin PIN --------------------------------------------------------------
# Required. Read only on the server (src/app/api/verify-pin).
# If this is empty or missing, that endpoint returns HTTP 500
# "server_misconfigured" and the admin login always fails — not because the PIN
# was wrong, but because there is no PIN to compare against.
ADMIN_PIN=your_secret_pin_here

# -- Session secret ---------------------------------------------------------
# Kunci penandatangan cookie sesi admin (fitur "ingat saya"). WAJIB diisi, dan
# hanya dibaca di server (src/lib/session.ts).
#
# Buat nilai acak yang panjang, misalnya:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Mengganti nilai ini akan membuat semua cookie sesi lama tidak berlaku lagi.
SESSION_SECRET=your_long_random_session_secret

# -- Signaling room id ------------------------------------------------------
# The room where the SDP offer/answer and ICE candidates are written.
# IMPORTANT: this must exactly match the room id hardcoded in firestore.rules.
# Firestore rules cannot read env vars, so if the two differ, every signaling
# request is rejected with PERMISSION_DENIED.
# Changing the room id means editing both files and redeploying the rules.
NEXT_PUBLIC_ROOM_ID=your_room_id
