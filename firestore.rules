rules_version = '2';

// ===========================================================================
//  SECURITY MODEL - READ THIS FIRST
// ===========================================================================
//
//  There is NO authentication on the Firestore room in this project. Video is
//  peer-to-peer, but the SDP offer/answer and the ICE candidates travel through
//  Firestore, so anyone who can write to this room can impersonate the caller
//  or the receiver.
//
//  What actually protects the app is the room id being unguessable. If the room
//  id leaks (shared URL, screenshot, log file), anyone can write a fake
//  offer/answer into that room.
//
//  The rules below tighten the CALL LIFECYCLE, not identity. They make it
//  impossible to answer a call twice, or to answer a call that has already been
//  replaced by a newer one, and they stop one call's write from landing inside
//  another. What they deliberately do NOT do is establish who is who: whoever
//  writes first is still treated as the caller. Only Firebase Auth could do
//  that, and it changes the receiver flow because the receiver would have to
//  sign in before auto-answer works.
//
//  Rotating the room id means changing TWO files and redeploying the rules:
//    1. the room id below
//    2. NEXT_PUBLIC_ROOM_ID in .env.example / .env.local
//  If only one of them changes, signaling is rejected entirely.
//
//  MIGRATION NOTE: reading resource.data.callId on a document that predates
//  callId is an error, which denies the write. Any room document left over from
//  before callIds existed must be deleted once when these rules go live, or the
//  very first startCall after deploy is rejected. From then on no client can
//  delete it: see the delete note on the room rule below.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // A call-starting write: identifies itself, claims the room, and carries
    // nothing else. An answer here would mean the caller answering itself.
    function isCallStart() {
      return request.resource.data.keys().hasOnly(['callId', 'offer', 'status', 'createdAt'])
          && request.resource.data.callId is string
          && request.resource.data.status == 'calling';
    }

    // The write belongs to the call that is currently in the document.
    function isSameCall() {
      return request.resource.data.callId == resource.data.callId;
    }

    // ── IDENTITY ─────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    // An admin is whoever has a document in /admins. That collection has no
    // client-writable path, so it can only be provisioned with admin
    // credentials — nobody can promote themselves by writing to it.
    function isAdmin() {
      return signedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ── ROSTER ───────────────────────────────────────────────────────────────

    match /admins/{uid} {
      // Only your own admin record, so a signed-in client can tell whether it is
      // an admin. Deliberately not open to every signed-in user: that would let
      // any receiver enumerate the whole admin roster.
      //
      // Note the isAdmin() helper does not depend on this. exists() inside a rule
      // is evaluated server-side and needs no read permission on the document.
      allow read: if isSelf(uid);

      // No client writes here, ever. Provisioned once with admin credentials.
      allow write: if false;
    }

    match /users/{uid} {
      // The admin needs to see everyone in order to build a call list; a receiver
      // only ever needs itself.
      allow read: if isAdmin() || isSelf(uid);

      // Registering writes your own profile, unapproved. Requiring
      // approved == false here is what stops a receiver approving itself at
      // signup — the field is pinned to false by the only rule that may create
      // the document, and pinned by comparison in the self-update rule below.
      allow create: if isSelf(uid)
                    && request.resource.data.approved == false
                    && request.resource.data.keys().hasOnly(
                         ['displayName', 'approved', 'online', 'lastSeen', 'createdAt']);

      // Approval is the admin's job alone.
      allow update: if isAdmin();

      // A receiver may refresh its own name and presence, but cannot move its
      // own approval state in either direction.
      allow update: if isSelf(uid)
                    && request.resource.data.approved == resource.data.approved;

      allow delete: if false;
    }

    // VConnect signaling room.
    //
    // TRANSITIONAL — this room is still the old shared one and is still
    // completely unauthenticated. It stays that way until the client is rewired
    // to address rooms per receiver; tightening it before then would break
    // every call, because the current client has no Firebase session to present.
    // Do not treat this rule as the finished security model.
    //
    // The room id is hardcoded because Firestore rules cannot read env vars.
    // Any other room id does not match this rule and falls through to deny.
    match /rooms/vc-ud589l6e1gq0vc4y22tp {
      // Open, because a receiver sitting idle with no session of its own has to
      // be able to see that a call is ringing. This is the direct cost of having
      // no auth: the SDP is readable by anyone who knows the room id.
      allow read: if true;

      allow create: if isCallStart();

      // Starting a call over a live document is how a new call replaces an old
      // one. Demanding a different callId is what makes that deliberate: every
      // in-flight write belonging to the previous call now fails against these
      // rules instead of quietly landing on top of the new call's offer.
      allow update: if isCallStart()
                    && request.resource.data.callId != resource.data.callId;

      // Answering: once only, into the call that is actually live, and only
      // while the caller is still waiting.
      allow update: if isSameCall()
                    && resource.data.status == 'calling'
                    && !('answer' in resource.data)
                    && request.resource.data.status == 'connected';

      // Ending: only the call currently in progress can be ended. A stale tab
      // writing "ended" onto a newer call is rejected rather than allowed to
      // kill someone else's ringing phone.
      allow update: if isSameCall()
                    && resource.data.status in ['calling', 'connected']
                    && request.resource.data.status == 'ended';

      // Deliberately NO delete. Deleting the room document is precisely what used
      // to tear calls down: it fires every client's watcher, which closes their
      // peer connection, and the window before the next write is long enough for
      // a live call to die in the middle. With delete unavailable there is no
      // longer a code path that can do it. A finished document is inert — the
      // next startCall overwrites it, and an incoming call is only ever reported
      // for status "calling". Resetting the room by hand therefore needs
      // firebase firestore:delete, which uses admin credentials and bypasses
      // these rules.

      // ICE candidates from the caller (admin).
      // Tagged with a callId so a client can ignore candidates belonging to a
      // call it never took part in; the rules do not police that, the client
      // does.
      match /callerCandidates/{candidateId} {
        allow read, write: if true;
      }

      // ICE candidates from the receiver.
      match /receiverCandidates/{candidateId} {
        allow read, write: if true;
      }
    }

    // Deliberately no catch-all match: every path not covered above is denied
    // by Firestore by default.
  }
}